# Copy this file to .env and fill in your own values.
# Get BOT_TOKEN from @BotFather on Telegram (search for it in Telegram, send /newbot).
# NEVER commit your real .env file or share your token with anyone.

BOT_TOKEN=your_bot_token_here

# Path to the SQLite database file (created automatically on first run).
DB_PATH=meds.db

# How often (in seconds) the bot checks whether a reminder is due.
REMINDER_CHECK_INTERVAL_SECONDS=60

# Minutes to wait after a reminder before sending one gentle follow-up nudge.
FOLLOWUP_NUDGE_MINUTES=15

# Minutes to wait (with no response) before marking a dose "missed" and
# notifying the linked caregiver(s).
ESCALATION_WINDOW_MINUTES=45

# How long a /mycode linking code stays valid, in minutes.
LINK_CODE_TTL_MINUTES=30

# --- Status / uptime notifications (optional) ---
# Your own Telegram numeric user ID. Message @userinfobot on Telegram to get
# it. If set, the bot messages this ID when it starts and (on a graceful
# stop only) when it shuts down. Leave blank to disable.
ADMIN_TELEGRAM_ID=

# --- "Ask a Question" health-info assistant (optional) ---
# Get a free key at https://aistudio.google.com/apikey
# Leave blank to disable this feature entirely.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# IMPORTANT: these default to Singapore numbers. If your users are
# elsewhere, change these, or the bot will tell someone in a real
# emergency to call the wrong number.
EMERGENCY_NUMBER=995 (ambulance) or 999 (police)
CRISIS_HOTLINE_NAME=Samaritans of Singapore (SOS)
CRISIS_HOTLINE_NUMBER=1767

# Minimum seconds between two questions from the same person (prevents
# accidental double-taps or spam from running up your Gemini API bill).
ASK_COOLDOWN_SECONDS=20
